rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own data in the hosts collection
    match /hosts/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to subcollections (like localSpots, inquiries, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Fallback rule for safety (optional but good practice)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
